import { ScrollView, TextEdit } from "std-widgets.slint";
import "../assets/fonts/UbuntuSans-Regular.ttf";
import "../assets/fonts/UbuntuSans-Medium.ttf";
import "../assets/fonts/UbuntuSans-SemiBold.ttf";
import "../assets/fonts/UbuntuSans-Bold.ttf";

export struct DiskRow {
    label: string,
    detail: string,
    number: int,
}

// Slint 1.18.1 con renderizado parcial (el de Windows): cuando la sesión acumula más
// de 1024 cambios de texto, su caché de maquetación descarta entradas y un Text deja de
// repintarse al cambiar su contenido si no cambia nada más (color, tamaño o posición):
// la ventana mostraba un mensaje antiguo hasta recuperar el foco. Este Text alterna su
// color un 1 % de opacidad (imperceptible) con cada cambio para que siempre se repinte.
// Úsalo, con `base-color` en lugar de `color`, en todo texto que cambie con la app abierta.
component LiveText inherits Text {
    in property <color> base-color: #ffffff;
    private property <bool> flip;
    changed text => { flip = !flip; }
    color: flip ? base-color.transparentize(1%) : base-color;
}

component ActionButton inherits Rectangle {
    in property <string> label;
    in property <string> help-text: "";
    in property <bool> help-align-right: false;
    in property <bool> help-above: false;
    in property <bool> help-detailed: false;
    in property <bool> enabled: true;
    in property <bool> primary: false;
    in property <bool> quiet: false;
    in property <bool> destructive: false;
    callback clicked;
    height: 40px;
    border-radius: 11px;
    background: !enabled ? #33333399 : primary ? button-touch.pressed ? #cecece : button-touch.has-hover ? #ffffff : #e5e5e5 : destructive ? button-touch.pressed ? #603138dd : button-touch.has-hover ? #4d2e33e8 : #352629dd : quiet ? button-touch.pressed ? #454545cc : button-touch.has-hover ? #383838cc : #2b2b2bbb : button-touch.pressed ? #505050e6 : button-touch.has-hover ? #404040dd : #303030cc;
    border-color: !enabled ? #77777733 : primary ? #e5e5e5 : destructive ? button-touch.has-hover ? #c77882 : #87545a : quiet ? button-touch.has-hover ? #aaaaaa7a : #88888855 : button-touch.has-hover ? #bdbdbd99 : #aaaaaa66;
    border-width: 1px;
    animate background, border-color { duration: 120ms; }
    LiveText {
        text: root.label;
        base-color: !root.enabled ? #898989 : root.primary ? #111111 : root.destructive ? #f6bec4 : root.quiet ? #d0d0d0 : #f5f5f5;
        font-size: 14px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    button-touch := TouchArea {
        changed has-hover => {
            if (self.has-hover && root.help-text != "") {
                help-delay.start();
            } else {
                help-delay.stop();
                help-popup.close();
            }
        }
        clicked => {
            help-delay.stop();
            help-popup.close();
            if (root.enabled) { root.clicked(); }
        }
    }
    help-delay := Timer {
        interval: 2500ms;
        running: false;
        triggered() => {
            self.stop();
            if (button-touch.has-hover && root.help-text != "") { help-popup.show(); }
        }
    }
    help-popup := PopupWindow {
        x: root.help-align-right ? root.width - self.width : 0px;
        y: root.help-above ? -self.height - 8px : root.height + 8px;
        width: root.help-detailed ? 380px : max(250px, min(340px, root.width));
        height: root.help-detailed ? 110px : 84px;
        close-policy: close-on-click-outside;
        Rectangle {
            border-radius: 11px;
            background: #252525;
            border-color: #898989;
            border-width: 1px;
            Text {
                x: 12px; y: 8px;
                width: parent.width - 24px; height: parent.height - 16px;
                text: root.help-text;
                color: #f0f0f0;
                font-size: 14px;
                font-weight: 700;
                wrap: word-wrap;
                vertical-alignment: center;
            }
        }
    }
}

component RoundedSelect inherits Rectangle {
    in property <[string]> options;
    in property <int> current-index: 0;
    in property <bool> enabled: true;
    in property <string> help-text: "";
    callback selected(int);

    height: 40px;
    border-radius: 11px;
    background: !root.enabled ? #33333399 : select-touch.pressed ? #505050e6 : select-touch.has-hover ? #404040dd : #303030cc;
    border-color: !root.enabled ? #77777733 : select-touch.has-hover ? #bdbdbd99 : #aaaaaa66;
    border-width: 1px;
    animate background, border-color { duration: 120ms; }

    LiveText {
        x: 13px;
        width: parent.width - 43px;
        height: parent.height;
        text: root.options[root.current-index];
        base-color: root.enabled ? #f5f5f5 : #898989;
        font-family: "Ubuntu Sans";
        font-size: 14px;
        font-weight: 600;
        vertical-alignment: center;
        overflow: elide;
    }
    Text {
        x: parent.width - 28px;
        width: 19px;
        height: parent.height;
        text: "⌄";
        color: root.enabled ? #d5d8dc : #898989;
        font-family: "Ubuntu Sans";
        font-size: 20px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    select-touch := TouchArea {
        changed has-hover => {
            if (self.has-hover && root.help-text != "") {
                help-delay.start();
            } else {
                help-delay.stop();
                help-popup.close();
            }
        }
        clicked => {
            help-delay.stop();
            help-popup.close();
            if (root.enabled) { menu.show(); }
        }
    }
    help-delay := Timer {
        interval: 2500ms;
        running: false;
        triggered() => {
            self.stop();
            if (select-touch.has-hover && root.help-text != "") { help-popup.show(); }
        }
    }
    help-popup := PopupWindow {
        x: 0px; y: -self.height - 8px;
        width: 285px; height: 80px;
        close-policy: close-on-click-outside;
        Rectangle {
            border-radius: 11px;
            background: #252525;
            border-color: #898989;
            border-width: 1px;
            Text {
                x: 12px; y: 8px;
                width: parent.width - 24px; height: parent.height - 16px;
                text: root.help-text;
                color: #f0f0f0;
                font-size: 14px;
                font-weight: 700;
                wrap: word-wrap;
                vertical-alignment: center;
            }
        }
    }

    menu := PopupWindow {
        x: 0px;
        y: root.height + 8px;
        width: root.width;
        height: root.options.length * 48px + 4px;
        close-policy: close-on-click-outside;
        Rectangle {
            border-radius: 9px;
            background: #282828f5;
            border-color: #aaaaaa66;
            border-width: 1px;
            VerticalLayout {
                padding: 6px;
                spacing: 8px;
                for option[index] in root.options : Rectangle {
                    height: 40px;
                    border-radius: 6px;
                    background: option-touch.pressed ? #595959e8 : option-touch.has-hover ? #4b4b4be8 : index == root.current-index ? #454545dc : #303030d6;
                    animate background { duration: 100ms; }
                    Text {
                        x: 9px;
                        width: parent.width - 18px;
                        height: parent.height;
                        text: option;
                        color: #f5f5f5;
                        font-family: "Ubuntu Sans";
                        font-size: 14px;
                        font-weight: index == root.current-index ? 700 : 500;
                        vertical-alignment: center;
                    }
                    option-touch := TouchArea {
                        clicked => {
                            root.selected(index);
                            menu.close();
                        }
                    }
                }
            }
        }
    }
}

component FormatSelect inherits Rectangle {
    in property <string> caption;
    in property <string> help-text;
    in property <[string]> options;
    in property <int> current-index: 0;
    in property <bool> enabled: true;
    callback selected(int);

    height: 64px;
    background: transparent;
    Text {
        text: root.caption;
        x: 0px; y: 0px;
        width: parent.width; height: 16px;
        color: #c2c2c2;
        font-size: 12px;
        font-weight: 700;
    }
    RoundedSelect {
        x: 0px; y: 24px;
        width: parent.width;
        options: root.options;
        current-index: root.current-index;
        enabled: root.enabled;
        help-text: root.help-text;
        selected(index) => { root.selected(index); }
    }
}

// Botón cuadrado de la cabecera con icono (carpeta de descargas, registro) y ayuda
// contextual tras 2500 ms de hover. El icono se coloca como hijo del componente.
component HeaderButton inherits Rectangle {
    in property <string> help-text;
    callback clicked;
    width: 38px;
    height: 38px;
    border-radius: 11px;
    background: header-touch.pressed ? #505050e6 : header-touch.has-hover ? #404040dd : #303030cc;
    border-color: header-touch.has-hover ? #bdbdbd99 : #aaaaaa66;
    border-width: 1px;
    animate background, border-color { duration: 120ms; }
    @children
    header-touch := TouchArea {
        changed has-hover => {
            if (self.has-hover) { help-delay.start(); }
            else { help-delay.stop(); help-popup.close(); }
        }
        clicked => { help-delay.stop(); help-popup.close(); root.clicked(); }
    }
    help-delay := Timer {
        interval: 2500ms; running: false;
        triggered() => { self.stop(); if (header-touch.has-hover) { help-popup.show(); } }
    }
    help-popup := PopupWindow {
        x: root.width - self.width; y: root.height + 8px;
        width: 280px; height: 80px;
        close-policy: close-on-click-outside;
        Rectangle {
            border-radius: 11px; background: #252525;
            border-color: #898989; border-width: 1px;
            Text {
                x: 12px; y: 8px; width: parent.width - 24px; height: parent.height - 16px;
                text: root.help-text;
                color: #f0f0f0; font-size: 14px; font-weight: 700; wrap: word-wrap; vertical-alignment: center;
            }
        }
    }
}

component StepBadge inherits Rectangle {
    in property <string> number;
    in property <bool> current: false;
    in property <bool> done: false;

    width: 28px;
    height: 28px;
    border-radius: 14px;
    background: current ? #e8e8e8 : done ? #20402cee : #252525d6;
    border-color: current ? #ffffff : done ? #71d995c4 : #77777770;
    border-width: 1px;
    clip: true;
    animate background, border-color { duration: 180ms; }
    if root.done : Rectangle {
        x: 3px; y: 2px;
        width: 22px; height: 9px;
        border-radius: 5px;
        background: #ffffff1c;
    }
    Text {
        text: root.done ? "✓" : root.number;
        color: root.current ? #171717 : root.done ? #b5f0c4 : #b7b7b7;
        font-size: root.done ? 16px : 12px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component MainWindow inherits Window {
    title: "WinSlim USB Creator";
    icon: @image-url("../assets/icon.png");
    preferred-width: 1200px;
    preferred-height: 1040px;
    min-width: 680px;
    min-height: 530px;
    // Invertir `redraw-flip` cambia el valor del fondo y obliga a repintar toda la ventana
    // (tras restaurarla y en cada mensaje de estado). Ambos valores pintan exactamente
    // #101010: el degradado tiene sus dos paradas iguales. No alternar dos colores
    // distintos: #101011 (un nivel más de azul) se veía como un parpadeo azulado
    // cuatro veces por segundo durante la descarga, la verificación y la copia.
    background: redraw-flip ? @linear-gradient(180deg, #101010 0%, #101010 100%) : #101010;
    default-font-family: "Ubuntu Sans";

    in-out property <bool> redraw-flip: false;

    in-out property <string> iso-name: "Ninguna ISO seleccionada";
    in-out property <string> iso-size: "";
    // -1: descarga no disponible; 0: comprobando; 1: ISO accesible.
    in-out property <int> server-availability: 0;
    // -1: sin descarga alternativa; 0: comprobando; 1: enlace alternativo accesible.
    in-out property <int> alternative-availability: 0;
    // Descarga o verificación de la ISO en curso: el paso 01 solo ofrece cancelarla.
    private property <bool> operation-active: root.download-active || root.verifying;
    // Fila de disponibilidad del paso 01.
    private property <bool> local-iso-shown: root.iso-stage == 2 && !root.download-active;
    // Con la ISO ya descargada la fila muestra su verificación, no el estado de los servidores.
    private property <bool> downloaded-shown: root.iso-stage == 3 && !root.download-active;
    private property <bool> servers-pending: root.server-availability == 0 || root.alternative-availability == 0;
    private property <bool> sources-shown: !root.local-iso-shown && !root.downloaded-shown && !root.servers-pending;
    // 1 verde, -1 rojo, 0 gris para el primer indicador de la fila.
    private property <int> main-tone: root.local-iso-shown ? 1
        : root.downloaded-shown ? (root.iso-verified && !root.verifying ? 1 : 0)
        : root.servers-pending ? 0 : root.server-availability;
    // El servidor principal no ofrece la ISO, pero la descarga alternativa sí.
    private property <bool> alternative-only: root.server-availability == -1 && root.alternative-availability == 1;
    // Sin ISO localizada ni descargada: se ofrece la alternativa junto a la búsqueda.
    private property <bool> alternative-mode: root.alternative-only && !root.operation-active && root.iso-stage == 0;
    in-out property <string> local-file: "Sin descargar";
    in-out property <string> status-text: "Listo";
    // -2: comprobando; -1: no se pudo comprobar; 0: deshabilitado; 1: habilitado.
    in-out property <int> tpm-status: -2;
    in-out property <int> secure-boot-status: -2;
    in-out property <float> progress: 0;
    in-out property <bool> busy: false;
    in-out property <bool> usb-detecting: false;
    // 0: sin ISO; 1: ISO localizada en el servidor; 2: ISO local; 3: ISO descargada.
    in-out property <int> iso-stage: 0;
    in-out property <bool> preparation-complete: false;
    private property <int> active-step: root.preparation-complete ? 4 : root.iso-stage < 2 ? 1 : root.selected-disk < 0 ? 2 : 3;
    in-out property <bool> download-active: false;
    in-out property <bool> download-cancelling: false;
    // La ISO descargada (paso 03) superó la comprobación de MD5 y no ha cambiado desde entonces.
    in-out property <bool> iso-verified: false;
    // «Verificar integridad de la ISO» en curso y su cancelación.
    in-out property <bool> verifying: false;
    in-out property <bool> verification-cancelling: false;
    // Preparación del USB en curso (formateo, copia o verificación).
    in-out property <bool> preparing: false;
    in-out property <bool> close-confirm-visible: false;
    in-out property <bool> confirm-visible: false;
    in-out property <bool> confirm-reinstall: false;
    in-out property <string> confirm-disk: "";
    in-out property <int> selected-disk: -1;
    in-out property <[DiskRow]> disks: [];
    in-out property <bool> gpt: false;
    in-out property <bool> ntfs: false;
    in-out property <bool> reuse-ventoy: false;
    in-out property <bool> logs-visible: false;
    in-out property <string> log-text: "";
    in-out property <bool> success-visible: false;
    in-out property <string> success-detail: "";
    in-out property <string> restart-message: "";
    in-out property <string> restart-instructions: "";
    in-out property <bool> restart-pending: false;
    in-out property <image> success-backdrop;

    callback lookup-iso();
    callback download-iso();
    callback download-alternative-iso();
    callback download-latest-iso();
    callback cancel-download();
    callback verify-iso();
    callback cancel-verification();
    callback load-local-iso();
    callback discard-local-iso();
    callback open-downloads-folder();
    callback refresh-usb();
    callback select-disk(int);
    callback request-prepare(bool);
    callback confirm-prepare();
    callback cancel-prepare();
    callback show-logs();
    callback close-logs();
    callback copy-logs();
    callback open-log-folder();
    callback clear-logs();
    callback export-logs();
    callback close-success();
    callback close-app();
    callback confirm-close();
    callback cancel-close();
    callback restart-to-usb();

    VerticalLayout {
        width: parent.width;
        height: parent.height;
        spacing: 0px;
        header := Rectangle {
            height: 64px;
            background: @linear-gradient(180deg, #1f1f1fe8 0%, #151515e8 55%, #0c0c0cf0 100%);
            border-color: #a0a0a05e;
            border-width: 1px;
            Rectangle {
                x: (header.width - self.width) / 2;
                width: 540px;
                height: header.height;
                background: @radial-gradient(circle 270px, #ffffff13 0%, #ffffff00 100%);
            }
            if header.width >= 900px : Rectangle {
                x: 34px; y: 31px;
                width: header.width / 2 - 260px; height: 1px;
                background: @linear-gradient(90deg, #d0d0d000 0%, #d0d0d03d 100%);
            }
            if header.width >= 900px : Rectangle {
                x: header.width / 2 + 220px; y: 31px;
                width: header.width / 2 - 300px; height: 1px;
                background: @linear-gradient(90deg, #d0d0d03d 0%, #d0d0d000 100%);
            }
            brand := Rectangle {
                x: (header.width - self.width) / 2;
                width: 300px; height: header.height;
                background: transparent;
                Image {
                    source: @image-url("../assets/icon-header-40.png");
                    x: 0px; y: 12px;
                    width: 40px; height: 40px;
                    image-fit: contain;
                }
                Text {
                    text: "WinSlim USB Creator";
                    x: 50px; y: 0px;
                    width: 250px; height: parent.height;
                    color: #f8f8f8;
                    font-size: 24px;
                    font-weight: 700;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
            HeaderButton {
                x: header.width - 104px; y: 13px;
                help-text: "Abre la carpeta donde la aplicación guarda las ISO descargadas.";
                clicked => { root.open-downloads-folder(); }
                // Carpeta con una flecha de descarga: acceso a las ISO descargadas.
                Path {
                    x: 9px; y: 9px;
                    width: 20px; height: 20px;
                    viewbox-width: 20; viewbox-height: 20;
                    commands: "M 1 4 Q 1 2.5 2.5 2.5 L 7 2.5 L 9 4.5 L 17.5 4.5 Q 19 4.5 19 6 L 19 16 Q 19 17.5 17.5 17.5 L 2.5 17.5 Q 1 17.5 1 16 Z M 10 7.5 L 10 14 M 7.25 11.25 L 10 14 L 12.75 11.25";
                    fill: transparent;
                    stroke: #f5f5f5;
                    stroke-width: 2px;
                    stroke-line-cap: round;
                    stroke-line-join: round;
                }
            }
            HeaderButton {
                x: header.width - 58px; y: 13px;
                help-text: "Muestra la actividad de la aplicación y los detalles de posibles errores.";
                clicked => { root.show-logs(); }
                // Hoja con líneas: acceso al registro de actividad.
                Rectangle {
                    x: 11px; y: 8px;
                    width: 16px; height: 21px;
                    border-radius: 2px;
                    background: transparent;
                    border-color: #f5f5f5;
                    border-width: 2px;
                    Rectangle { x: 3px; y: 5px; width: 8px; height: 2px; background: #f5f5f5; }
                    Rectangle { x: 3px; y: 10px; width: 8px; height: 2px; background: #f5f5f5; }
                    Rectangle { x: 3px; y: 15px; width: 6px; height: 2px; background: #f5f5f5; }
                }
            }
        }

        ScrollView {
            VerticalLayout {
                padding: 20px;
                spacing: 18px;
                intro := Rectangle {
                    height: 98px;
                    border-radius: 14px;
                    background: transparent;
                    border-color: #c0c0c080;
                    border-width: 1px;
                    clip: true;
                    Rectangle {
                        x: 1px; y: 1px;
                        width: parent.width - 2px; height: parent.height - 2px;
                        border-radius: 13px;
                        background: #222222;
                    }
                    Text {
                        x: 20px; y: 11px;
                        width: parent.width - 40px; height: 36px;
                        text: "Prepara tu USB de WinSlim";
                        color: #f7f7f7; font-size: 28px; font-weight: 700;
                    }
                    Text {
                        x: 20px; y: 53px;
                        width: parent.width - 40px;
                        height: 36px;
                        text: "Descarga la versión más reciente o selecciona una imagen ISO local para crear una unidad de arranque e instalación en solo unos pasos.";
                        color: #b6bcc7; font-size: 15px; font-weight: 700; wrap: word-wrap;
                    }
                }

                Rectangle {
                    height: root.operation-active ? 220px : root.alternative-mode ? (root.width >= 900px ? 235px : 295px) : root.iso-stage == 2 ? (root.width < 900px ? 290px : 260px) : root.iso-stage == 1 ? (root.width >= 1020px ? 235px : 278px) : root.iso-stage == 3 ? (root.width >= 900px ? 235px : 290px) : 220px;
                    border-radius: 14px;
                    background: root.active-step == 1 ? #202020ee : root.active-step > 1 ? #191919e8 : #161616e6;
                    border-color: root.active-step == 1 ? #d8d8d8ae : root.active-step > 1 ? #99999970 : #77777755;
                    border-width: root.active-step == 1 ? 2px : 1px;
                    animate background, border-color { duration: 180ms; }
                    Rectangle {
                        x: 14px; y: 1px;
                        width: parent.width - 28px; height: 1px;
                        background: root.active-step == 1 ? #ffffff36 : #ffffff1c;
                    }
                    VerticalLayout {
                        padding: 17px;
                        spacing: 10px;
                        HorizontalLayout {
                            height: 28px;
                            spacing: 10px;
                            StepBadge { number: "01"; current: root.active-step == 1; done: root.active-step > 1; }
                            Text { text: "Selecciona de dónde cargas la imagen:"; color: #f0f2f5; font-size: 16px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
                        }
                        LiveText {
                            text: root.download-active
                                ? "La descarga de la ISO está en curso. Puedes cancelarla en cualquier momento."
                                : root.verifying
                                ? "Verificando la integridad de la ISO descargada. Puedes cancelar la verificación en cualquier momento."
                                : root.iso-stage == 1
                                ? "La última ISO está localizada. Descárgala en la aplicación o abre la alternativa en el navegador."
                                : root.iso-stage == 2
                                ? "La ISO local está lista para el paso 02. Puedes descartarla, cambiarla o descargar la última versión."
                                : root.iso-stage == 3 && root.iso-verified
                                ? "La ISO descargada está verificada y lista para el paso 02. Puedes buscar otra versión o cargar una imagen local."
                                : root.iso-stage == 3
                                ? "La ISO ya está descargada y lista para el paso 02. Puedes verificar su integridad antes de continuar."
                                : root.alternative-mode
                                ? "La ISO no está disponible en el servidor principal. Prueba con «Descarga alternativa de la ISO» o elige una imagen de tu equipo con «Cargar ISO local»."
                                : "Selecciona «Buscar última ISO de WinSlim en línea» para consultar la versión más reciente, o «Cargar ISO local» para elegir una imagen de tu equipo.";
                            base-color: #b9c0cc;
                            font-size: 14px;
                            font-weight: 700;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            height: 26px;
                            spacing: 10px;
                            LiveText {
                                text: root.iso-name;
                                base-color: #ffffff;
                                font-size: 17px;
                                font-weight: 600;
                                max-width: 460px;
                                horizontal-stretch: 0;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            if root.iso-size != "" : Rectangle {
                                width: 96px; height: 26px;
                                border-radius: 13px;
                                background: #303030e8;
                                border-color: #a0a0a078;
                                border-width: 1px;
                                LiveText {
                                    text: root.iso-size;
                                    base-color: #dedede;
                                    font-size: 13px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                        }
                        // Disponibilidad: ISO local, verificación de la ISO descargada, «Conectando…»
                        // mientras se comprueba o el estado de cada fuente (verde disponible, rojo no
                        // disponible, gris comprobando o pendiente).
                        HorizontalLayout {
                            height: 20px;
                            spacing: 8px;
                            Rectangle {
                                width: 10px; height: 20px; background: transparent;
                                Rectangle {
                                    y: 5px; width: 10px; height: 10px; border-radius: 5px;
                                    background: root.main-tone == 1 ? #51cc79 : root.main-tone == -1 ? #e56868 : #aab3be;
                                }
                            }
                            LiveText {
                                text: root.local-iso-shown ? "ISO local cargada"
                                    : root.downloaded-shown && root.verifying ? "ISO descargada: verificando su integridad…"
                                    : root.downloaded-shown && root.iso-verified ? "ISO descargada: integridad verificada"
                                    : root.downloaded-shown ? "ISO descargada: integridad sin verificar"
                                    : root.servers-pending ? "Conectando con los servidores de descarga…"
                                    : root.server-availability == 1 ? "Servidor principal: disponible"
                                    : "Servidor principal: no disponible";
                                base-color: root.main-tone == 1 ? #9be4ae : root.main-tone == -1 ? #f0a4a4 : #afb4bd;
                                font-size: 14px;
                                vertical-alignment: center;
                                horizontal-stretch: 0;
                                overflow: elide;
                            }
                            if root.sources-shown : Rectangle { width: 14px; background: transparent; }
                            if root.sources-shown : Rectangle {
                                width: 10px; height: 20px; background: transparent;
                                Rectangle {
                                    y: 5px; width: 10px; height: 10px; border-radius: 5px;
                                    background: root.alternative-availability == 1 ? #51cc79 : #e56868;
                                }
                            }
                            if root.sources-shown : LiveText {
                                text: root.alternative-availability == 1 ? "Descarga alternativa: disponible" : "Descarga alternativa: no disponible";
                                base-color: root.alternative-availability == 1 ? #9be4ae : #f0a4a4;
                                font-size: 14px;
                                vertical-alignment: center;
                                horizontal-stretch: 0;
                                overflow: elide;
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                        }
                        if root.iso-stage == 2 && !root.download-active : LiveText {
                            text: "Ruta de origen: " + root.local-file;
                            base-color: #afb4bd;
                            font-size: 14px;
                            wrap: word-wrap;
                            vertical-stretch: 0;
                        }
                        if root.operation-active : HorizontalLayout {
                            spacing: 10px;
                            if root.download-active : ActionButton {
                                label: root.download-cancelling ? "Cancelando…" : "Cancelar descarga";
                                help-text: "Detiene la descarga y elimina el archivo incompleto.";
                                width: 175px;
                                destructive: true;
                                enabled: !root.download-cancelling;
                                clicked => { root.cancel-download(); }
                            }
                            if root.verifying : ActionButton {
                                label: root.verification-cancelling ? "Cancelando…" : "Cancelar verificación";
                                help-text: "Detiene la verificación. La ISO descargada no se modifica.";
                                width: 190px;
                                destructive: true;
                                enabled: !root.verification-cancelling;
                                clicked => { root.cancel-verification(); }
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                        }
                        if !root.operation-active && root.iso-stage == 0 && !root.alternative-mode : HorizontalLayout {
                            spacing: 10px;
                            ActionButton {
                                label: "Buscar última ISO de WinSlim en línea";
                                help-text: "Busca la versión más reciente de WinSlim disponible para descargar.";
                                width: 280px;
                                primary: true;
                                enabled: !root.busy;
                                clicked => { root.lookup-iso(); }
                            }
                            ActionButton {
                                label: "Cargar ISO local";
                                help-text: "Abre el explorador para elegir una ISO guardada en el equipo.";
                                width: 150px;
                                enabled: !root.busy;
                                clicked => { root.load-local-iso(); }
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                        }
                        // ISO local cargada: descartarla vuelve a la última ISO localizada en línea.
                        if !root.operation-active && root.iso-stage == 2 : HorizontalLayout {
                            spacing: 10px;
                            ActionButton {
                                label: "Descartar ISO local";
                                help-text: "Deja de usar esta ISO y vuelve a la última ISO de WinSlim disponible en línea. El archivo no se elimina del equipo.";
                                min-width: 165px;
                                horizontal-stretch: 1;
                                primary: true;
                                enabled: !root.busy;
                                clicked => { root.discard-local-iso(); }
                            }
                            if !root.alternative-only : ActionButton {
                                label: "Descargar última ISO";
                                help-text: "Busca y descarga la última ISO. La imagen local seguirá disponible durante la descarga.";
                                min-width: 185px;
                                horizontal-stretch: 1;
                                enabled: !root.busy;
                                clicked => { root.download-latest-iso(); }
                            }
                            if root.alternative-only : ActionButton {
                                label: "Descarga alternativa de la ISO";
                                help-text: "La ISO no está disponible en el servidor principal. Abre en el navegador una opción alternativa para descargarla.";
                                min-width: 240px;
                                horizontal-stretch: 1;
                                enabled: !root.busy;
                                clicked => { root.download-alternative-iso(); }
                            }
                            ActionButton {
                                label: "Cambiar ISO local";
                                help-text: "Abre el explorador para elegir otra ISO guardada en el equipo.";
                                help-align-right: true;
                                min-width: 150px;
                                horizontal-stretch: 1;
                                quiet: true;
                                enabled: !root.busy;
                                clicked => { root.load-local-iso(); }
                            }
                        }
                        // ISO ya descargada: el siguiente paso es el 02, así que ningún botón destaca.
                        if !root.operation-active && root.iso-stage == 3 && root.width >= 900px : HorizontalLayout {
                            spacing: 10px;
                            ActionButton {
                                label: "Verificar integridad de la ISO";
                                help-text: "Comprueba que la ISO descargada está completa y coincide con la suma MD5 publicada. También se comprueba antes de copiarla al USB.";
                                help-detailed: true;
                                min-width: 235px;
                                horizontal-stretch: 1;
                                enabled: !root.busy;
                                clicked => { root.verify-iso(); }
                            }
                            ActionButton {
                                label: "Volver a buscar la última ISO";
                                help-text: "Comprueba si hay una versión más reciente de la ISO.";
                                min-width: 255px;
                                horizontal-stretch: 1;
                                quiet: true;
                                enabled: !root.busy;
                                clicked => { root.lookup-iso(); }
                            }
                            ActionButton {
                                label: "Cargar ISO local";
                                help-text: "Elige una ISO que ya esté guardada en el equipo.";
                                help-align-right: true;
                                min-width: 175px;
                                horizontal-stretch: 1;
                                quiet: true;
                                enabled: !root.busy;
                                clicked => { root.load-local-iso(); }
                            }
                        }
                        if !root.operation-active && root.iso-stage == 3 && root.width < 900px : ActionButton {
                            label: "Verificar integridad de la ISO";
                            help-text: "Comprueba que la ISO descargada está completa y coincide con la suma MD5 publicada. También se comprueba antes de copiarla al USB.";
                            help-detailed: true;
                            enabled: !root.busy;
                            clicked => { root.verify-iso(); }
                        }
                        if !root.operation-active && root.iso-stage == 3 && root.width < 900px : HorizontalLayout {
                            spacing: 10px;
                            ActionButton {
                                label: "Volver a buscar la última ISO";
                                help-text: "Comprueba si hay una versión más reciente de la ISO.";
                                min-width: 255px;
                                horizontal-stretch: 1;
                                quiet: true;
                                enabled: !root.busy;
                                clicked => { root.lookup-iso(); }
                            }
                            ActionButton {
                                label: "Cargar ISO local";
                                help-text: "Elige una ISO que ya esté guardada en el equipo.";
                                help-align-right: true;
                                min-width: 175px;
                                horizontal-stretch: 1;
                                quiet: true;
                                enabled: !root.busy;
                                clicked => { root.load-local-iso(); }
                            }
                        }
                        if root.alternative-mode && root.width >= 900px : HorizontalLayout {
                            spacing: 10px;
                            ActionButton {
                                label: "Descarga alternativa de la ISO";
                                help-text: "La ISO no está disponible en el servidor principal. Abre en el navegador una opción alternativa para descargarla.";
                                min-width: 240px;
                                horizontal-stretch: 1;
                                primary: true;
                                enabled: !root.busy;
                                clicked => { root.download-alternative-iso(); }
                            }
                            ActionButton {
                                label: "Volver a buscar la última ISO";
                                help-text: "Comprueba de nuevo si la ISO está disponible en el servidor principal.";
                                min-width: 255px;
                                horizontal-stretch: 1;
                                quiet: true;
                                enabled: !root.busy;
                                clicked => { root.lookup-iso(); }
                            }
                            ActionButton {
                                label: "Cargar ISO local";
                                help-text: "Elige una ISO que ya esté guardada en el equipo.";
                                help-align-right: true;
                                min-width: 175px;
                                horizontal-stretch: 1;
                                quiet: true;
                                enabled: !root.busy;
                                clicked => { root.load-local-iso(); }
                            }
                        }
                        if root.alternative-mode && root.width < 900px : ActionButton {
                            label: "Descarga alternativa de la ISO";
                            help-text: "La ISO no está disponible en el servidor principal. Abre en el navegador una opción alternativa para descargarla.";
                            primary: true;
                            enabled: !root.busy;
                            clicked => { root.download-alternative-iso(); }
                        }
                        if root.alternative-mode && root.width < 900px : HorizontalLayout {
                            spacing: 10px;
                            ActionButton {
                                label: "Volver a buscar la última ISO";
                                help-text: "Comprueba de nuevo si la ISO está disponible en el servidor principal.";
                                min-width: 255px;
                                horizontal-stretch: 1;
                                quiet: true;
                                enabled: !root.busy;
                                clicked => { root.lookup-iso(); }
                            }
                            ActionButton {
                                label: "Cargar ISO local";
                                help-text: "Elige una ISO que ya esté guardada en el equipo.";
                                help-align-right: true;
                                min-width: 175px;
                                horizontal-stretch: 1;
                                quiet: true;
                                enabled: !root.busy;
                                clicked => { root.load-local-iso(); }
                            }
                        }
                        if !root.download-active && root.iso-stage == 1 && root.width >= 1020px : HorizontalLayout {
                            spacing: 10px;
                            ActionButton {
                                label: "Descarga directa de la ISO";
                                help-text: "Descarga automáticamente la versión más reciente de la ISO desde la aplicación. Una vez completada la descarga, la ISO se cargará y quedará lista para continuar.";
                                help-detailed: true;
                                min-width: 210px;
                                horizontal-stretch: 1;
                                primary: true;
                                enabled: !root.busy;
                                clicked => { root.download-iso(); }
                            }
                            ActionButton {
                                label: "Descarga alternativa de la ISO";
                                help-text: "Abre en el navegador una opción alternativa para descargar la ISO.";
                                min-width: 240px;
                                horizontal-stretch: 1;
                                enabled: !root.busy;
                                clicked => { root.download-alternative-iso(); }
                            }
                            ActionButton {
                                label: "Volver a buscar la última ISO";
                                help-text: "Comprueba de nuevo si hay una versión más reciente de la ISO.";
                                min-width: 255px;
                                horizontal-stretch: 1;
                                quiet: true;
                                enabled: !root.busy;
                                clicked => { root.lookup-iso(); }
                            }
                            ActionButton {
                                label: "Cargar ISO local";
                                help-text: "Elige una ISO que ya esté guardada en el equipo.";
                                help-align-right: true;
                                min-width: 175px;
                                horizontal-stretch: 1;
                                quiet: true;
                                enabled: !root.busy;
                                clicked => { root.load-local-iso(); }
                            }
                        }
                        if !root.download-active && root.iso-stage == 1 && root.width < 1020px : HorizontalLayout {
                            spacing: 10px;
                            ActionButton {
                                label: "Descarga directa de la ISO";
                                help-text: "Descarga automáticamente la versión más reciente de la ISO desde la aplicación. Una vez completada la descarga, la ISO se cargará y quedará lista para continuar.";
                                help-detailed: true;
                                min-width: 210px;
                                horizontal-stretch: 1;
                                primary: true;
                                enabled: !root.busy;
                                clicked => { root.download-iso(); }
                            }
                            ActionButton {
                                label: "Descarga alternativa de la ISO";
                                help-text: "Abre en el navegador una opción alternativa para descargar la ISO.";
                                help-align-right: true;
                                min-width: 240px;
                                horizontal-stretch: 1;
                                enabled: !root.busy;
                                clicked => { root.download-alternative-iso(); }
                            }
                        }
                        if !root.download-active && root.iso-stage == 1 && root.width < 1020px : HorizontalLayout {
                            spacing: 10px;
                            ActionButton {
                                label: "Volver a buscar la última ISO";
                                help-text: "Comprueba de nuevo si hay una versión más reciente de la ISO.";
                                min-width: 255px;
                                horizontal-stretch: 1;
                                quiet: true;
                                enabled: !root.busy;
                                clicked => { root.lookup-iso(); }
                            }
                            ActionButton {
                                label: "Cargar ISO local";
                                help-text: "Elige una ISO que ya esté guardada en el equipo.";
                                help-align-right: true;
                                min-width: 175px;
                                horizontal-stretch: 1;
                                quiet: true;
                                enabled: !root.busy;
                                clicked => { root.load-local-iso(); }
                            }
                        }
                    }
                }

                Rectangle {
                    height: root.reuse-ventoy ? (root.height >= 1030px ? 245px : 215px) : root.height >= 1030px ? 290px : 245px;
                    border-radius: 14px;
                    background: root.active-step == 2 ? #202020ee : root.active-step > 2 ? #191919e8 : #161616e6;
                    border-color: root.active-step == 2 ? #d8d8d8ae : root.active-step > 2 ? #99999970 : #77777755;
                    border-width: root.active-step == 2 ? 2px : 1px;
                    animate background, border-color { duration: 180ms; }
                    Rectangle {
                        x: 14px; y: 1px;
                        width: parent.width - 28px; height: 1px;
                        background: root.active-step == 2 ? #ffffff36 : #ffffff1c;
                    }
                    VerticalLayout {
                        padding: 17px;
                        spacing: 9px;
                        HorizontalLayout {
                            spacing: 12px;
                            Rectangle {
                                width: 28px; height: 40px; background: transparent;
                                StepBadge { y: 6px; number: "02"; current: root.active-step == 2; done: root.active-step > 2; }
                            }
                            Text { text: "Selecciona la unidad USB en la que prepararemos la instalación de la ISO de WinSlim."; color: #f0f2f5; font-size: 16px; font-weight: 700; wrap: word-wrap; vertical-alignment: center; horizontal-stretch: 1; }
                            ActionButton { label: "Volver a detectar unidades"; help-text: "Vuelve a buscar las unidades USB conectadas y actualiza la lista."; help-align-right: true; width: 220px; enabled: !root.busy; clicked => { root.refresh-usb(); } }
                        }
                        LiveText { text: root.usb-detecting ? "Buscando unidades USB…" : root.disks.length == 0 ? "No se detectaron unidades USB" : root.reuse-ventoy ? "Ventoy detectado: puedes copiar sin borrar o formatear la unidad de nuevo" : "La unidad seleccionada se formateará y perderá todo su contenido."; base-color: #afb4bd; font-size: 14px; font-weight: 700; }
                        HorizontalLayout {
                            padding-top: 6px;
                            spacing: 12px;
                            disk-scroll := ScrollView {
                                vertical-scrollbar-policy: always-off;
                                horizontal-scrollbar-policy: always-off;
                                VerticalLayout {
                                    spacing: 9px;
                                    for disk in root.disks : Rectangle {
                                        height: 74px;
                                        border-radius: 10px;
                                        background: root.selected-disk == disk.number ? disk-touch.has-hover && !root.busy ? #515151e8 : #414141e2 : disk-touch.has-hover && !root.busy ? #393939e0 : #2e2e2ed6;
                                        border-color: root.selected-disk == disk.number ? #d5d5d5 : disk-touch.has-hover && !root.busy ? #bdbdbd99 : #aaaaaa45;
                                        border-width: 1px;
                                        animate background, border-color { duration: 120ms; }
                                        VerticalLayout {
                                            padding-left: 14px;
                                            padding-right: 14px;
                                            padding-top: 10px;
                                            padding-bottom: 10px;
                                            spacing: 5px;
                                            LiveText { text: disk.label; base-color: #f5f5f5; font-size: 14px; font-weight: 600; overflow: elide; }
                                            LiveText { text: disk.detail; base-color: #aeb3bc; font-size: 12px; overflow: elide; }
                                        }
                                        disk-touch := TouchArea { enabled: !root.busy; clicked => { root.select-disk(disk.number); } }
                                    }
                                }
                            }
                            scroll-track := Rectangle {
                                width: 12px;
                                visible: disk-scroll.content-height > disk-scroll.visible-height;
                                border-radius: 6px;
                                background: #303030dd;
                                thumb := Rectangle {
                                    x: 3px;
                                    width: 6px;
                                    height: max(32px, (parent.height - 4px) * disk-scroll.visible-height / disk-scroll.content-height);
                                    y: 2px + (parent.height - 4px - self.height) * (-disk-scroll.content-y / max(1px, disk-scroll.content-height - disk-scroll.visible-height));
                                    border-radius: 3px;
                                    background: #969ba3;
                                }
                                TouchArea {
                                    property <length> drag-start-y;
                                    property <length> drag-start-content;
                                    property <bool> dragging-thumb;
                                    pointer-event(event) => {
                                        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                                            self.drag-start-y = self.mouse-y;
                                            self.drag-start-content = disk-scroll.content-y;
                                            self.dragging-thumb = self.mouse-y >= thumb.y && self.mouse-y <= thumb.y + thumb.height;
                                        }
                                    }
                                    moved => {
                                        if (self.pressed && self.dragging-thumb) {
                                            disk-scroll.content-y = max(disk-scroll.visible-height - disk-scroll.content-height,
                                                min(0px, self.drag-start-content - (self.mouse-y - self.drag-start-y)
                                                * (disk-scroll.content-height - disk-scroll.visible-height)
                                                / max(1px, scroll-track.height - thumb.height - 4px)));
                                        }
                                    }
                                    clicked => {
                                        if (!self.dragging-thumb) {
                                            disk-scroll.content-y = -max(0px, min(disk-scroll.content-height - disk-scroll.visible-height,
                                                (self.mouse-y - thumb.height / 2) * (disk-scroll.content-height - disk-scroll.visible-height)
                                                / max(1px, scroll-track.height - thumb.height - 4px)));
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                Rectangle {
                    height: root.reuse-ventoy ? (root.width < 900px ? 216px : 190px) : (root.width < 900px ? 160px : 140px);
                    border-radius: 14px;
                    background: root.active-step == 3 ? #202020ee : root.active-step > 3 ? #191919e8 : #161616e6;
                    border-color: root.active-step == 3 ? #d8d8d8ae : root.active-step > 3 ? #99999970 : #77777755;
                    border-width: root.active-step == 3 ? 2px : 1px;
                    animate background, border-color { duration: 180ms; }
                    Rectangle {
                        x: 14px; y: 1px;
                        width: parent.width - 28px; height: 1px;
                        background: root.active-step == 3 ? #ffffff36 : #ffffff1c;
                    }
                    VerticalLayout {
                        padding-left: 17px;
                        padding-right: 17px;
                        padding-top: 14px;
                        padding-bottom: 14px;
                        spacing: 16px;
                        HorizontalLayout {
                            height: root.width < 900px ? 42px : 28px;
                            spacing: 10px;
                            StepBadge { number: "03"; current: root.active-step == 3; done: root.active-step > 3; }
                            LiveText {
                                text: root.preparation-complete
                                    ? "USB preparado. Puedes cerrar la aplicación o iniciar desde la unidad."
                                    : root.reuse-ventoy
                                    ? "Copia la ISO sin borrar los archivos, o formatea y prepara de nuevo la unidad con el formato seleccionado."
                                    : "Elige el formato de la unidad y pulsa «Preparar USB» para instalar Ventoy y copiar la ISO.";
                                base-color: #f0f2f5;
                                font-size: 16px;
                                font-weight: 700;
                                wrap: word-wrap;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                        }
                        if !root.reuse-ventoy : HorizontalLayout {
                            height: 64px;
                            spacing: 20px;
                            FormatSelect { caption: "Esquema de partición"; help-text: "Elige cómo se organiza el arranque del USB. MBR funciona en más equipos."; options: ["MBR (recomendado)", "GPT"]; current-index: root.gpt ? 1 : 0; width: 175px; enabled: !root.busy; selected(index) => { root.gpt = index == 1; } }
                            FormatSelect { caption: "Sistema de archivos"; help-text: "Elige el formato de almacenamiento del USB. exFAT funciona con más sistemas."; options: ["exFAT (recomendado)", "NTFS"]; current-index: root.ntfs ? 1 : 0; width: 195px; enabled: !root.busy; selected(index) => { root.ntfs = index == 1; } }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Rectangle {
                                width: 156px; background: transparent;
                                ActionButton { y: 24px; width: parent.width; label: "Preparar USB"; help-text: "Prepara el USB para arrancar y copia la ISO elegida. Se borrarán los archivos de la unidad."; help-align-right: true; help-above: true; primary: true; enabled: !root.busy && root.selected-disk >= 0 && root.iso-stage >= 2; clicked => { root.request-prepare(false); } }
                            }
                        }
                        if root.reuse-ventoy : VerticalLayout {
                            vertical-stretch: 0;
                            spacing: 10px;
                            HorizontalLayout {
                                height: 64px;
                                spacing: 20px;
                                FormatSelect { caption: "Esquema de partición"; help-text: "Elige cómo se organiza el arranque del USB. MBR funciona en más equipos."; options: ["MBR (recomendado)", "GPT"]; current-index: root.gpt ? 1 : 0; width: 175px; enabled: !root.busy; selected(index) => { root.gpt = index == 1; } }
                                FormatSelect { caption: "Sistema de archivos"; help-text: "Elige el formato para preparar de nuevo el USB. exFAT funciona con más sistemas."; options: ["exFAT (recomendado)", "NTFS"]; current-index: root.ntfs ? 1 : 0; width: 195px; enabled: !root.busy; selected(index) => { root.ntfs = index == 1; } }
                            }
                            HorizontalLayout {
                                height: 40px;
                                spacing: 12px;
                                Rectangle { horizontal-stretch: 1; background: transparent; }
                                ActionButton { label: "Copiar ISO al USB seleccionado"; help-text: "Copia la ISO al USB sin borrar los demás archivos de la unidad."; help-above: true; width: 245px; primary: true; enabled: !root.busy && root.selected-disk >= 0 && root.iso-stage >= 2; clicked => { root.request-prepare(false); } }
                                ActionButton { label: "Formatear y preparar de nuevo"; help-text: "Borra el USB, vuelve a prepararlo para arrancar y copia la ISO elegida."; help-align-right: true; help-above: true; width: 255px; enabled: !root.busy && root.selected-disk >= 0 && root.iso-stage >= 2; clicked => { root.request-prepare(true); } }
                            }
                        }
                    }
                }
                Rectangle { vertical-stretch: 1; background: transparent; }
            }
        }

        Rectangle {
            height: 92px;
            background: #222222cc;
            border-color: #a0a0a05e;
            border-width: 1px;
            VerticalLayout {
                padding-left: 22px;
                padding-right: 22px;
                padding-top: 10px;
                padding-bottom: 10px;
                spacing: 7px;
                // Hasta dos líneas: las indicaciones largas no se cortan en ventanas estrechas.
                LiveText { text: root.status-text; base-color: #f1f3f6; font-size: 16px; font-weight: 700; wrap: word-wrap; overflow: elide; vertical-stretch: 1; }
                HorizontalLayout {
                    height: 18px;
                    spacing: 6px;
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Rectangle {
                        width: 9px; height: 18px; background: transparent;
                        Rectangle {
                            y: 5px; width: 8px; height: 8px; border-radius: 4px;
                            background: root.tpm-status == 1 ? #51cc79 : root.tpm-status == 0 ? #e7a34f : #9d9d9d;
                        }
                    }
                    LiveText {
                        text: root.tpm-status == 1 ? "TPM: Habilitado" : root.tpm-status == 0 ? "TPM: Deshabilitado / no disponible" : root.tpm-status == -2 ? "TPM: Comprobando…" : "TPM: No se pudo comprobar";
                        base-color: #d0d0d0; font-size: 13px; vertical-alignment: center; horizontal-stretch: 0;
                    }
                    Rectangle { width: 12px; background: transparent; }
                    Rectangle {
                        width: 9px; height: 18px; background: transparent;
                        Rectangle {
                            y: 5px; width: 8px; height: 8px; border-radius: 4px;
                            background: root.secure-boot-status == 1 ? #e56868 : root.secure-boot-status == 0 ? #51cc79 : #9d9d9d;
                        }
                    }
                    LiveText {
                        text: root.secure-boot-status == 1 ? "Secure Boot: Habilitado" : root.secure-boot-status == 0 ? "Secure Boot: Deshabilitado" : root.secure-boot-status == -2 ? "Secure Boot: Comprobando…" : "Secure Boot: No se pudo comprobar";
                        base-color: #d0d0d0; font-size: 13px; vertical-alignment: center; horizontal-stretch: 0;
                    }
                }
                Rectangle {
                    height: 6px;
                    border-radius: 3px;
                    background: #77777777;
                    Rectangle { x: 0px; width: parent.width * root.progress; height: parent.height; border-radius: 3px; background: #e3e6eb; }
                }
            }
        }
    }

    if root.confirm-visible : Rectangle {
        background: #000000b8;
        // Bloquea los clics y la rueda sobre la pantalla de detrás: sin esto se
        // podía elegir otro USB mientras el aviso mostraba el anterior.
        TouchArea {
            scroll-event(event) => { return accept; }
        }
        Rectangle {
            width: 500px;
            height: 270px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 14px;
            background: #282828f2;
            border-color: #aaaaaa77;
            border-width: 1px;
            VerticalLayout {
                padding: 25px;
                spacing: 17px;
                Text { text: root.reuse-ventoy && !root.confirm-reinstall ? "Confirmar copia de la ISO" : "Confirmar formateo del USB"; color: #ffffff; font-size: 21px; font-weight: 700; }
                Text { text: root.reuse-ventoy && !root.confirm-reinstall ? "Ventoy ya está instalado. Se conservarán sus particiones y archivos en:" : "Se eliminarán todas las particiones y todos los datos de:"; color: #d1d4da; font-size: 14px; wrap: word-wrap; }
                Text { text: root.confirm-disk; color: #ffffff; font-size: 15px; font-weight: 700; wrap: word-wrap; }
                Text { text: root.reuse-ventoy && !root.confirm-reinstall ? "Solo se añadirá la ISO. Si ya existe otra con el mismo nombre, se guardará una copia nueva." : root.confirm-reinstall ? "Se reinstalará Ventoy con el formato elegido y después se copiará la ISO." : "Comprueba el modelo y la capacidad antes de continuar."; color: #bfc5cd; font-size: 13px; wrap: word-wrap; }
                Rectangle { vertical-stretch: 1; background: transparent; }
                HorizontalLayout {
                    spacing: 10px;
                    ActionButton { label: "Cancelar"; help-text: "Cierra esta confirmación sin modificar la unidad USB."; help-above: true; width: 130px; clicked => { root.cancel-prepare(); } }
                    ActionButton { label: root.reuse-ventoy && !root.confirm-reinstall ? "Copiar ISO" : "Borrar y preparar"; help-text: root.reuse-ventoy && !root.confirm-reinstall ? "Confirma la copia de la ISO sin formatear la unidad." : "Confirma el borrado y la preparación de la unidad seleccionada."; help-above: true; width: 175px; primary: true; clicked => { root.confirm-prepare(); } }
                }
            }
        }
    }

    if root.logs-visible : Rectangle {
        background: #000000c8;
        TouchArea {
            scroll-event(event) => { return accept; }
        }
        Rectangle {
            width: Math.min(parent.width - 36px, 850px);
            height: Math.min(parent.height - 36px, 690px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 12px;
            background: #282828f2;
            border-color: #aaaaaa77;
            border-width: 1px;
            VerticalLayout {
                padding: 18px;
                spacing: 12px;
                HorizontalLayout {
                    Text { text: "Registro y diagnóstico"; color: #ffffff; font-size: 20px; font-weight: 700; }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    ActionButton { label: "Cerrar"; help-text: "Cierra el registro y vuelve a la pantalla principal."; help-align-right: true; width: 82px; clicked => { root.close-logs(); } }
                }
                Text { text: "El registro se actualiza mientras la ventana está abierta. Puedes seleccionar y copiar líneas."; color: #bfc5cd; font-size: 12px; }
                TextEdit { text: root.log-text; read-only: true; font-size: 12px; }
                HorizontalLayout {
                    spacing: 8px;
                    ActionButton { label: "Copiar todo"; help-text: "Copia todas las líneas visibles del registro al portapapeles."; help-above: true; width: 112px; clicked => { root.copy-logs(); } }
                    ActionButton { label: "Abrir carpeta"; help-text: "Abre la carpeta donde se guarda el archivo del registro."; help-above: true; width: 118px; clicked => { root.open-log-folder(); } }
                    ActionButton { label: "Exportar"; help-text: "Guarda una copia del registro para revisarla o compartirla."; help-above: true; width: 94px; clicked => { root.export-logs(); } }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    ActionButton { label: "Limpiar"; help-text: "Vacía el contenido del registro mostrado."; help-align-right: true; help-above: true; width: 88px; clicked => { root.clear-logs(); } }
                }
            }
        }
    }

    if root.success-visible : Rectangle {
        background: #101010;
        Image { source: root.success-backdrop; width: parent.width; height: parent.height; image-fit: fill; }
        Rectangle { background: #08080870; }
        TouchArea { }
        Rectangle {
            width: Math.min(parent.width - 40px, 620px);
            height: 474px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 16px;
            background: #252525ed;
            border-color: #aaaaaa70;
            border-width: 1px;
            Rectangle {
                x: (parent.width - self.width) / 2; y: 28px;
                width: 66px; height: 66px;
                border-radius: 33px;
                background: #353b39;
                border-color: #a9d8b0;
                border-width: 2px;
                Text { text: "✓"; color: #d8f5dc; font-size: 36px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
            }
            Text {
                text: "USB preparado correctamente";
                x: 24px; y: 112px; width: parent.width - 48px; height: 34px;
                color: #ffffff; font-size: 24px; font-weight: 700;
                horizontal-alignment: center;
            }
            Text {
                text: "La ISO se ha copiado y verificado. Tu USB ya está listo para instalar WinSlim.";
                x: 34px; y: 156px; width: parent.width - 68px; height: 46px;
                color: #d7dbe0; font-size: 15px; wrap: word-wrap;
                horizontal-alignment: center;
            }
            Rectangle {
                x: 25px; y: 210px; width: parent.width - 50px; height: 48px;
                border-radius: 8px; background: #303030dd; border-color: #aaaaaa55; border-width: 1px;
                LiveText { text: root.success-detail; x: 12px; width: parent.width - 24px; base-color: #f1f2f3; font-size: 13px; font-weight: 600; overflow: elide; vertical-alignment: center; }
            }
            Rectangle {
                x: 25px; y: 268px; width: parent.width - 50px; height: 72px;
                border-radius: 8px;
                background: root.secure-boot-status == 1 ? #302528e8 : root.secure-boot-status == 0 ? #222c25e8 : #2b2b2be8;
                border-color: root.secure-boot-status == 1 ? #a9707888 : root.secure-boot-status == 0 ? #6ea67977 : #aaaaaa66;
                border-width: 1px;
                Rectangle {
                    x: 13px; y: 31px; width: 9px; height: 9px; border-radius: 5px;
                    background: root.secure-boot-status == 1 ? #e56868 : root.secure-boot-status == 0 ? #51cc79 : #a0a0a0;
                }
                LiveText {
                    x: 32px; y: 7px; width: parent.width - 44px; height: 58px;
                    text: root.secure-boot-status == 1
                        ? "Secure Boot habilitado. Desactívalo en UEFI antes de arrancar desde este USB para evitar «Security Violation [0x0]» y vuelve a activarlo al terminar la instalación."
                        : root.secure-boot-status == 0
                        ? "Secure Boot deshabilitado. Ya puedes arrancar desde el USB sin cambiar este ajuste."
                        : root.secure-boot-status == -2
                        ? "Comprobando el estado de Secure Boot antes de iniciar la instalación…"
                        : "No se pudo comprobar Secure Boot. Verifica en UEFI que esté deshabilitado antes de arrancar desde el USB para evitar «Security Violation [0x0]» y reactívalo tras la instalación.";
                    base-color: root.secure-boot-status == 1 ? #f1c6cb : root.secure-boot-status == 0 ? #b9dfbf : #d6d6d6;
                    font-size: 13px; font-weight: 600; wrap: word-wrap; vertical-alignment: center;
                }
            }
            LiveText {
                text: root.restart-message == "" ? root.restart-instructions : root.restart-message;
                x: 30px; y: 353px; width: parent.width - 60px; height: 42px;
                base-color: root.restart-message == "" ? #afb7c0 : #f2c3bb;
                font-size: 13px; wrap: word-wrap; horizontal-alignment: center;
            }
            HorizontalLayout {
                x: 24px; y: 412px; width: parent.width - 48px; height: 40px;
                spacing: 10px;
                ActionButton { label: "Cerrar"; help-text: "Cierra este resumen y vuelve a la aplicación."; help-above: true; horizontal-stretch: 1; clicked => { root.close-success(); } }
                ActionButton { label: "Salir de la app"; help-text: "Cierra WinSlim USB Creator; el USB preparado permanecerá listo."; help-above: true; horizontal-stretch: 1; clicked => { root.close-app(); } }
                ActionButton { label: root.restart-pending ? "Reiniciando…" : "Reiniciar y elegir USB"; help-text: "Reinicia el equipo y abre las opciones de arranque para elegir la unidad USB."; help-align-right: true; help-above: true; horizontal-stretch: 2; primary: true; enabled: !root.restart-pending; clicked => { root.restart-to-usb(); } }
            }
        }
    }

    // Se muestra al cerrar la ventana durante una descarga o la preparación del USB.
    if root.close-confirm-visible : Rectangle {
        background: #000000c0;
        TouchArea {
            scroll-event(event) => { return accept; }
        }
        Rectangle {
            width: Math.min(parent.width - 36px, 500px);
            height: 230px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 14px;
            background: #282828f2;
            border-color: #aaaaaa77;
            border-width: 1px;
            VerticalLayout {
                padding: 25px;
                spacing: 14px;
                LiveText {
                    text: root.download-active || root.preparing ? "¿Cerrar con una operación en curso?" : "La operación ha terminado";
                    base-color: #ffffff; font-size: 21px; font-weight: 700; wrap: word-wrap;
                }
                LiveText {
                    text: root.download-active
                        ? "La descarga se detendrá. El progreso se conserva y podrás reanudarla la próxima vez que la inicies."
                        : root.preparing
                        ? "La preparación del USB se interrumpirá y la unidad puede quedar sin terminar. Tendrás que prepararla de nuevo."
                        : "Ya puedes cerrar la aplicación sin interrumpir nada.";
                    base-color: #d1d4da; font-size: 14px; wrap: word-wrap;
                }
                Rectangle { vertical-stretch: 1; background: transparent; }
                HorizontalLayout {
                    spacing: 10px;
                    ActionButton { label: "Seguir en la app"; help-text: "Vuelve a la aplicación sin cerrarla."; help-above: true; width: 150px; clicked => { root.cancel-close(); } }
                    ActionButton { label: "Cerrar"; help-text: root.download-active || root.preparing ? "Cierra la aplicación e interrumpe la operación en curso." : "Cierra WinSlim USB Creator."; help-above: true; width: 130px; destructive: root.download-active || root.preparing; primary: !root.download-active && !root.preparing; clicked => { root.confirm-close(); } }
                }
            }
        }
    }
}
